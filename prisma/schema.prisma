generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  PERSON
  COMPANY
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum EventStatus {
  PROSPECTIVE
  TENTATIVE
  DEFINITE
  COMPLETED
  CANCELLED
}

enum ServiceType {
  DROP_OFF
  BUFFET
  PLATED
  FAMILY_STYLE
  COCKTAIL
  STATIONS
}

enum MenuCategory {
  APPETIZER
  ENTREE
  SIDE
  SALAD
  DESSERT
  BEVERAGE
  BAR
  RENTAL
  LABOR
  OTHER
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OTHER
}

model Client {
  id           String     @id @default(cuid())
  type         ClientType @default(COMPANY)
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  region       String?
  postalCode   String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  events       Event[]
  leads        Lead[]

  @@index([name])
}

model Lead {
  id           String     @id @default(cuid())
  contactName  String
  companyName  String?
  email        String?
  phone        String?
  source       String?
  status       LeadStatus @default(NEW)
  eventDate    DateTime?
  guestCount   Int?
  budget       Decimal?   @db.Decimal(12, 2)
  notes        String?
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedEventId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Venue {
  id       String  @id @default(cuid())
  name     String
  address  String?
  capacity Int?
  notes    String?
  events   Event[]
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  category    MenuCategory @default(ENTREE)
  description String?
  unit        String       @default("per person")
  price       Decimal      @db.Decimal(10, 2)
  cost        Decimal      @default(0) @db.Decimal(10, 2)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  recipeLines    RecipeLine[]
  packingLines   PackingLine[]
  eventItems     EventItem[]
  packageItems   MenuPackageItem[]

  @@index([name])
  @@index([category])
}

model RecipeLine {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient String
  quantity   Decimal  @db.Decimal(10, 3)
  unit       String
}

model PackingLine {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  equipment  String
  quantity   Decimal  @db.Decimal(10, 3)
  unit       String   @default("ea")
}

model MenuPackage {
  id          String            @id @default(cuid())
  name        String
  description String?
  pricePerGuest Decimal         @db.Decimal(10, 2)
  active      Boolean           @default(true)
  items       MenuPackageItem[]
}

model MenuPackageItem {
  id         String      @id @default(cuid())
  packageId  String
  package    MenuPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Event {
  id               String      @id @default(cuid())
  number           Int         @unique @default(autoincrement())
  name             String
  status           EventStatus @default(TENTATIVE)
  serviceType      ServiceType @default(BUFFET)
  eventType        String?
  clientId         String
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  venueId          String?
  venue            Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  room             String?
  guestCount       Int         @default(0)
  startAt          DateTime
  endAt            DateTime
  arrivalAt        DateTime?
  siteAddress      String?
  serviceChargePct Decimal     @default(20) @db.Decimal(5, 2)
  taxPct           Decimal     @default(13) @db.Decimal(5, 2)
  discount         Decimal     @default(0) @db.Decimal(10, 2)
  clientNotes      String?
  kitchenNotes     String?
  staffNotes       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items     EventItem[]
  payments  Payment[]
  scheduled ScheduledPayment[]
  shifts    Shift[]
  tasks     Task[]

  @@index([startAt])
  @@index([clientId])
}

model EventItem {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name        String
  category    MenuCategory @default(ENTREE)
  description String?
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)
  taxable     Boolean      @default(true)
  position    Int          @default(0)

  @@index([eventId])
}

model Payment {
  id         String        @id @default(cuid())
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CARD)
  receivedAt DateTime      @default(now())
  reference  String?
  note       String?

  @@index([eventId])
}

model ScheduledPayment {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label   String
  amount  Decimal  @db.Decimal(12, 2)
  dueAt   DateTime
  paid    Boolean  @default(false)

  @@index([eventId])
}

model Staff {
  id         String   @id @default(cuid())
  name       String
  position   String?
  email      String?
  phone      String?
  hourlyRate Decimal  @default(0) @db.Decimal(10, 2)
  active     Boolean  @default(true)
  shifts     Shift[]
}

model Shift {
  id       String    @id @default(cuid())
  eventId  String
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position String
  startAt  DateTime
  endAt    DateTime
  staffId  String?
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([staffId])
}

model Task {
  id      String    @id @default(cuid())
  eventId String?
  event   Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title   String
  dueAt   DateTime?
  done    Boolean   @default(false)
  assignee String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

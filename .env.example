DATABASE_URL="postgresql://caterly:CHANGE_ME@127.0.0.1:5432/caterly?schema=public"

# Phase 1A performance instrumentation.
# Enable server-side Prisma query timing logs.
CATERLY_PERF_LOG="0"
# Queries at or above this duration are marked slow in performance logs.
CATERLY_SLOW_QUERY_MS="100"
# Enable browser Core Web Vitals logging.
NEXT_PUBLIC_CATERLY_PERF_LOG="0"
